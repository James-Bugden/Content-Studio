{
  "name": "content-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:private": "node scripts/check-private-paths.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "check:env": "node scripts/check-env.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:private && npm run check:secrets && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "jose": "6.2.12",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "5.0.1"
  }
}
