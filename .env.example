# Content Studio environment names. This file lists NAMES ONLY.
# Values live in Vercel project settings or an untracked .env.local.
# A value committed here is a defect; scripts/check-private-paths.mjs enforces it.

# Runtime mode: "live" uses real providers, "fake" uses synthetic in-memory adapters.
# "fake" is refused when VERCEL_ENV=production.
CS_DATA_MODE=
# Fake mode only: pin Taipei 'today' (YYYY-MM-DD) so synthetic fixture dates stay schedulable.
CS_FAKE_TODAY=
# Vercel preview only, fake mode only: allow the synthetic-owner sign-in for demos.
CS_ALLOW_PREVIEW_SYNTHETIC=
APP_BASE_URL=
APP_TIMEZONE=Asia/Taipei

# Auth.js (Google OIDC). The owner is identified by the immutable Google `sub`.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
CS_OWNER_GOOGLE_SUB=
CS_OWNER_EMAIL=
CS_VIEWER_GOOGLE_SUBS=

# Google Sheets / Drive service credentials (server-only).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_WRITE_ENABLED=
CS_SHEET_ID=
CS_DRIVE_ROOT_FOLDER_ID=
CS_ASSET_FOLDER_ID=
CS_HOOK_REFERENCE_FILE_IDS=

# Typefully (server-only).
TYPEFULLY_API_KEY=
TYPEFULLY_SOCIAL_SET_ID=

# Optional Sheet-fed Supabase read model (server-only; "off", "mirror" or "shadow").
# SOURCE_KEY is an opaque workbook alias, not the Sheet ID.
SUPABASE_READ_MODEL_MODE=off
SUPABASE_READ_MODEL_URL=
SUPABASE_READ_MODEL_SERVICE_KEY=
SUPABASE_READ_MODEL_SOURCE_KEY=

# AI proposals (server-only). AI_PROVIDER=fake needs no key.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Build metadata (Vercel sets VERCEL_GIT_COMMIT_SHA automatically).
CS_COMMIT_SHA=
